{
  "manifest_version": 3,
  "name": "MOBero",
  "version": "0.1.0",
  "description": "One-click Monero mining. Your wallet, your machine, 100% of the payout.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:45580/*",
    "https://api.coingecko.com/*",
    "https://xmrchain.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MOBero",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
